rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid)  { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['GM', 'Oficial'];
    }

    // Identidad: cada quien lee/escribe SU documento; los oficiales gestionan el roster.
    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Mensajeria privada: solo los participantes del hilo.
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }
    match /messages/{msgId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Config del sitio (asistencia activa, council activo, etc.)
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Resto del contenido del portal: lectura para miembros, escritura para oficiales.
    match /{collection}/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
